# Clerk Publishable Key (from Clerk Dashboard -> API Keys -> Publishable key)
# Local Vite (`npm run dev`) reads this from frontend/.env.
# Docker/CI must pass it as --build-arg VITE_CLERK_PUBLISHABLE_KEY=... (do not COPY .env).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API origin (browser → API). Baked into the Docker image at build time.
# For local Vite (`npm run dev`), leave as-is or empty to use the /api proxy.
VITE_API_BASE_URL=http://localhost:8000

# Offline UI/UX Mock Data Layer (true = offline mock data active, false = use live backend)
VITE_USE_MOCK=false

