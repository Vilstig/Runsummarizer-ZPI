# Required for Strava integration, essential for strava sync to work.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Required for Garmin Connect integration
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# OAuth callback, registered on the Garmin application page.
GARMIN_REDIRECT_URI=http://localhost:8000/api/providers/garmin/callback

# Required for Intervals.icu integration (https://intervals.icu/oauth/apply)
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=

# OAuth callback, registered in the Strava API application settings.
STRAVA_REDIRECT_URI=http://localhost:8000/api/providers/strava/callback
# OAuth callback, registered in the Intervals.icu API application settings.
INTERVALS_REDIRECT_URI=http://localhost:8000/api/providers/intervals/callback

# Shared secret echoed by Strava during webhook subscription validation.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Random secret required in the callback path: /api/webhooks/strava/<PATH_SECRET>
STRAVA_WEBHOOK_PATH_SECRET=

# Secret in the webhook path saved in Garmin API Tools: /api/webhooks/garmin/<PATH_SECRET>
GARMIN_WEBHOOK_PATH_SECRET=
# Random secret required in the callback path: /api/webhooks/intervals/<PATH_SECRET>
INTERVALS_WEBHOOK_PATH_SECRET=
# Secret Intervals.icu puts in the webhook body (from Manage App).
INTERVALS_WEBHOOK_SECRET=
# Public HTTPS callback registered with Strava, e.g.
# Local dev alternative: `hookdeck listen 8000 strava --path /api/webhooks/strava/YOUR_PATH_SECRET`
# A Hookdeck dashboard Source URL does NOT work: it can't relay this app's 
# real hub.challenge response back to Strava.
STRAVA_WEBHOOK_CALLBACK_URL=

OAUTH_STATE_SECRET=

# Required for encrypting provider tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Set to true only when the app runs behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Proxies in front of the app that append to X-Forwarded-For: 1 for the ALB alone,
# 2 when Cloudflare proxies to the ALB.
TRUSTED_PROXY_HOPS=1

# Async SQLAlchemy DSN for the Postgres backend (asyncpg driver).
# Alembic reads this to run migrations. Format:
# POSTGRES_DSN=postgresql+asyncpg://user:password@localhost:5432/runsummarizer
POSTGRES_DSN=

# Separate database for the repository contract suite (pytest tests/db); never the
# POSTGRES_DSN database. Migrate it with: POSTGRES_DSN=<this DSN> alembic upgrade head
# POSTGRES_DSN_TEST=postgresql+asyncpg://user:password@localhost:5432/runsummarizer_test
POSTGRES_DSN_TEST=

# Clerk Backend API secret from the Dashboard API keys page. Server-side only.
CLERK_SECRET_KEY=
# PEM public key from that page: Show JWT public key → PEM Public Key.
# One line, with the PEM newlines written as \n.
CLERK_JWT_KEY=
# Comma-separated frontend origins allowed to send a session token.
CLERK_AUTHORIZED_PARTIES=http://localhost:8080
# Svix signing secret from the Clerk webhook endpoint. Required at startup.
CLERK_WEBHOOK_SECRET=
# Frontend origin the OAuth callback redirects back to (Docker nginx / Vite preview).
FRONTEND_URL=http://localhost:8080

# Personal API key, read only by scripts/fetch_garmin_activities.py.
GARMIN_API_KEY=